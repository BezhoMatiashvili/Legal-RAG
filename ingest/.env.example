# Copy to .env, run `chmod 600 .env`, and adjust. .env is git-ignored but contains secrets.

# Qdrant connection (local Docker by default, bound to loopback)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY is REQUIRED whenever QDRANT_URL is not localhost/127.0.0.1 (the client
# refuses to connect to a remote host without it, and refuses to send it over non-HTTPS).
# When set, docker-compose also enforces it on the local container.
# QDRANT_API_KEY=

# Collection + embedding model
COLLECTION_NAME=georgian_legal
EMBED_MODEL=BAAI/bge-m3
DENSE_DIM=1024

# Embedding runtime
EMBED_DEVICE=               # blank = auto (cpu); set "cuda" or "mps" if available
EMBED_USE_FP16=false        # fp16 is unstable on CPU; keep false unless on GPU
EMBED_BATCH_SIZE=8

# Reranking (cross-encoder second stage over the hybrid candidate pool — big precision win)
RERANK_ENABLED=true                       # set false to fall back to raw RRF order
RERANK_MODEL=BAAI/bge-reranker-v2-m3      # multilingual, pairs with BGE-M3
RERANK_CANDIDATES=80                       # candidates fused before reranking (recall pool)
RERANK_MIN_SCORE=0.3                       # drop hits below this 0..1 score; "none" disables the gate
RERANK_DEVICE=                             # blank = follow EMBED_DEVICE; set "mps"/"cuda"
RERANK_USE_FP16=false                      # fp16 unstable on CPU; keep false unless on GPU

# Chunking (token budgets measured with the BGE-M3 tokenizer)
CHUNK_TOKENS=512
CHUNK_OVERLAP=80
CHUNK_MIN_TOKENS=64

# Where the scraper writes its JSONL output. Default: ../artifacts (sibling of ingest/).
# ARTIFACTS_ROOT=/absolute/path/to/artifacts
